{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rustc: build current file",
      "type": "shell",
      "command": "rustc",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "rustc: build current test",
      "type": "shell",
      "command": "rustc",
      "args": [
        "-g",
        "--test",
        "${file}",
        "-o",
        "${fileDirname}/test_${fileBasenameNoExtension}.exe"
      ],
      "group": "build",
      "problemMatcher": "$rustc"
    }
  ]
}
